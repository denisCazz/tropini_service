---
const viewBox = "0 0 560 640";
const path =
  "M143.1 316.1L138.5 305.8L151.8 289.6L136.9 278.3L142.8 265.5L144.4 273.6L158.2 275.2L166.4 265.7L185.2 265.2L204.8 251L218.3 249.2L225.7 255.3L247.3 258L263.9 248L276.6 249.1L276 244.7L283.4 238L277.3 229.2L282.9 220.7L270 206.1L272.7 167.2L278 162L292 162.2L300 152.2L299.8 140.1L320.2 131.1L322.8 122.3L308 105.5L318 96.7L329.4 96.1L339.9 83.4L348.5 80.5L346.4 71.4L371.9 61.9L375.7 83.1L368.6 97.4L373.6 104.9L371.3 107.7L386.9 114.6L400.7 135.3L418.7 140.4L421.2 155.2L393.6 182.9L397.9 197.2L391 209.8L397.6 219.4L408 222.9L405.8 230.9L412.9 231L414.1 239.4L409 239.3L416.7 247.4L418.4 264.5L431.4 271.8L441.1 291.6L419.5 295L427.1 301.4L414.5 313.4L410.3 313.5L403.7 301.1L390.3 298.6L385.9 302.7L387.9 308.1L380.9 313.5L387.4 316.6L388.8 321.8L385.2 322.7L391 324.4L386.3 324.8L389.6 332.4L385.5 333.6L394.8 331.6L388.7 339.1L400.6 349.7L409 372.4L417.9 368L428.7 374.8L437.8 366.2L450.7 365.3L452.9 377.2L461.7 379L468.5 395.7L478.3 400.1L480.8 405.3L477.1 408.5L481.2 415.5L496.6 416L498.5 425.3L505.8 429.4L504.3 462.4L492.1 467.6L481.8 457L476.2 459L471.1 447.9L456.5 445.8L448 453.8L454.1 470.5L438.3 470.3L430.5 486.1L418.6 466.1L402.9 465L394.5 481.6L376.1 478.8L372.4 484.2L367 480.7L356.7 491.1L338.1 477.4L328.4 488.4L332.7 498.7L329.5 504L320.1 508.3L319.2 516.7L312.5 519.6L311.7 526.3L304.4 526.4L309.8 532L305 536.6L308.1 539.4L305.4 544.4L310.9 552.6L305.9 559.8L296 557.5L290.4 561.2L296 565L295.2 568.9L273.7 568.5L252.5 560.7L245.8 564.4L247.2 572.9L251.9 572.9L246.3 578.1L235.7 562.9L236.9 552.9L230.4 552.9L227.2 558.8L194.1 563L193.3 566.6L181.5 565.9L178.8 559.5L168 560.6L151.6 547.9L120.6 540.3L118.6 530.8L99.7 513.2L100.7 500.7L110.4 498.7L97.8 487.6L94.1 476.7L107.6 467.9L113.7 458L110.2 450.6L112.9 445.4L131.8 445L132.2 441.5L119.4 421.5L123.5 414.2L120.4 410.6L107.4 405.5L95.4 408.3L75.9 396.4L78.4 384.5L73.6 378.2L75 373.2L62.4 371.9L60.4 360.9L54.2 354L79.1 341.9L92.9 348.9L101 346.7L100.8 339.9L110.2 339.6L113.4 331.6L133.9 329.8L143.3 321.3L143.1 316.1Z";

const cities = [
  { name: "Verbania", x: 390.8, y: 178.3, anchor: "middle", dx: 0, dy: -10 },
  { name: "Biella", x: 303.9, y: 255.4, anchor: "middle", dx: 0, dy: -10 },
  { name: "Novara", x: 402.5, y: 280.2, anchor: "start", dx: 8, dy: 4 },
  { name: "Torino", x: 239.3, y: 361.1, anchor: "end", dx: -10, dy: 4 },
  { name: "Asti", x: 330.1, y: 397.5, anchor: "start", dx: 8, dy: 4 },
  { name: "Alessandria", x: 402.1, y: 395.1, anchor: "start", dx: 8, dy: 4 },
  { name: "Cuneo", x: 215.1, y: 507.1, anchor: "end", dx: -10, dy: 16 },
];

const sede = { x: 239.1, y: 438.5, name: "Cavallermaggiore" };

interface Props {
  selezionabile?: boolean;
  compatta?: boolean;
}

const { selezionabile = false, compatta = false } = Astro.props;
const registro = globalThis as { __mappaPiemonte?: number };
registro.__mappaPiemonte = (registro.__mappaPiemonte ?? 0) + 1;
const titoloId = `mappa-piemonte-title-${registro.__mappaPiemonte}`;
---

<figure
  class:list={["mappa-piemonte", compatta && "mappa-piemonte--compatta"]}
  aria-label="Area di intervento Tropini Service in Piemonte"
  data-selezionabile={selezionabile ? "true" : undefined}
>
  <svg
    class="mappa-piemonte__svg"
    viewBox={viewBox}
    role={selezionabile ? "group" : "img"}
    aria-labelledby={titoloId}
  >
    <title id={titoloId}>Mappa del Piemonte con sede Tropini Service a Cavallermaggiore</title>
    <defs>
      <linearGradient id="piemonte-fill" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#f4f5f6" />
        <stop offset="100%" stop-color="#e7eaee" />
      </linearGradient>
    </defs>

    <rect width="560" height="640" fill="transparent" />

    <path
      class="mappa-piemonte__shape"
      d={path}
      fill="url(#piemonte-fill)"
    />
    <path
      d={path}
      fill="none"
      class="mappa-piemonte__stroke"
      stroke="currentColor"
      stroke-width="1.5"
    />

    {cities.map((c) => (
      <g
        class="mappa-piemonte__city"
        data-zona={selezionabile ? c.name : undefined}
        transform={`translate(${c.x} ${c.y})`}
        role={selezionabile ? "button" : undefined}
        tabindex={selezionabile ? 0 : undefined}
        aria-label={selezionabile ? c.name : undefined}
      >
        <circle class="mappa-piemonte__hit" r="18" />
        <circle class="mappa-piemonte__ring" r="8" />
        <circle class="mappa-piemonte__dot" r="3.4" />
        <text x={c.dx} y={c.dy} text-anchor={c.anchor}>{c.name}</text>
      </g>
    ))}

    <g
      class="mappa-piemonte__sede"
      data-zona={selezionabile ? sede.name : undefined}
      transform={`translate(${sede.x} ${sede.y})`}
      role={selezionabile ? "button" : undefined}
      tabindex={selezionabile ? 0 : undefined}
      aria-label={selezionabile ? sede.name : undefined}
    >
      <g class="mappa-piemonte__pulse-wrap" aria-hidden="true">
        <circle class="mappa-piemonte__pulse" r="22" />
      </g>
      <path
        class="mappa-piemonte__pin"
        d="M0 28 L-11 6 A28 28 0 1 1 11 6 Z"
      />
      <circle class="mappa-piemonte__pin-face" cy="-12" r="24" />
      <image
        href="/Logo_Tropini_Service.png"
        x="-19"
        y="-31"
        width="38"
        height="38"
        preserveAspectRatio="xMidYMid meet"
      />
      <g class="mappa-piemonte__sede-text" transform="translate(34 -16)">
        <rect class="mappa-piemonte__plate" x="-6" y="-16" width="132" height="38" />
        <text class="mappa-piemonte__sede-label" x="0" y="0" text-anchor="start">
          {sede.name}
        </text>
        <text class="mappa-piemonte__sede-sub" x="0" y="15" text-anchor="start">
          Sede
        </text>
      </g>
    </g>
  </svg>

  <figcaption class="mappa-piemonte__caption">
    <strong>Tutto il Piemonte</strong>
    <span>Interventi da Cavallermaggiore in tutta la regione</span>
  </figcaption>
</figure>

<style>
  .mappa-piemonte {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 28rem;
    margin: 0;
    padding: 1.25rem 1.25rem 1.1rem;
    border-radius: 0;
    overflow: hidden;
    color: #122033;
    background: #e7eef8;
    border: 1px solid #b7c6da;
  }

  .mappa-piemonte--compatta {
    min-height: 0;
    padding: 0.75rem;
  }

  .mappa-piemonte--compatta .mappa-piemonte__svg {
    min-height: 15rem;
    max-height: 20rem;
  }

  .mappa-piemonte__svg {
    width: 100%;
    flex: 1;
    min-height: 22rem;
    display: block;
  }

  .mappa-piemonte__shape {
    fill: #1e4d8c;
    stroke: rgba(255, 255, 255, 0.45);
    stroke-width: 3;
  }

  .mappa-piemonte__stroke {
    stroke: #0c305c;
    stroke-width: 3;
  }

  .mappa-piemonte__city text {
    fill: #ffffff;
    font-size: 14px;
    font-family: var(--font-family);
    font-weight: 600;
    letter-spacing: 0.01em;
    stroke: none;
  }

  .mappa-piemonte__ring {
    fill: none;
    stroke: #ffffff;
    stroke-width: 1.5;
  }

  .mappa-piemonte__dot {
    fill: #ffffff;
  }

  .mappa-piemonte__hit {
    fill: transparent;
  }

  .mappa-piemonte[data-selezionabile] [data-zona] {
    cursor: pointer;
  }

  .mappa-piemonte[data-selezionabile] [data-zona]:focus-visible {
    outline: 2px solid var(--color-text-strong);
    outline-offset: 2px;
  }

  .mappa-piemonte__city.is-selected .mappa-piemonte__ring {
    stroke: #ffedd5;
    stroke-width: 2.5;
  }

  .mappa-piemonte__city.is-selected .mappa-piemonte__dot {
    fill: #ffedd5;
  }

  .mappa-piemonte__city.is-selected text {
    fill: #ffedd5;
  }

  .mappa-piemonte__plate {
    fill: #ffffff;
    stroke: #0c305c;
    stroke-width: 1;
  }

  .mappa-piemonte__pin {
    fill: #9a3412;
    stroke: #ffffff;
    stroke-width: 2;
    filter: none;
  }

  .mappa-piemonte__pin-face {
    fill: #ffffff;
  }

  .mappa-piemonte__sede-label {
    fill: #122033;
    font-size: 13px;
    font-family: var(--font-family);
    font-weight: 700;
  }

  .mappa-piemonte__sede-sub {
    fill: #3f4654;
    font-size: 11px;
    font-family: var(--font-family);
    font-weight: 600;
  }

  .mappa-piemonte__pulse-wrap {
    transform-origin: 0 0;
    pointer-events: none;
  }

  .mappa-piemonte__pulse {
    fill: transparent;
    stroke: #ffedd5;
    stroke-width: 1.5;
    transform-origin: center;
    transform-box: fill-box;
    animation: none;
  }

  .mappa-piemonte__pulse--delay {
    animation-delay: 1.2s;
  }

  .mappa-piemonte__caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid #b7c6da;
  }

  .mappa-piemonte__caption strong {
    color: #122033;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .mappa-piemonte__caption span {
    color: #3f4654;
    font-size: 0.85rem;
  }

  @keyframes mappa-pulse {
    0% {
      transform: scale(0.55);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mappa-piemonte__pulse {
      animation: none;
      opacity: 0.25;
    }
  }

  @media (max-width: 900px) {
    .mappa-piemonte {
      min-height: 22rem;
    }

    .mappa-piemonte__svg {
      min-height: 18rem;
    }
  }
</style>

<script>
  document.querySelectorAll(".mappa-piemonte[data-selezionabile]").forEach((mappa) => {
    const scelte = mappa.querySelectorAll("[data-zona]");

    const segna = (zona: string) => {
      scelte.forEach((elemento) => {
        elemento.classList.toggle("is-selected", elemento.getAttribute("data-zona") === zona);
        if (elemento.getAttribute("data-zona") === zona) {
          elemento.setAttribute("aria-pressed", "true");
        } else {
          elemento.removeAttribute("aria-pressed");
        }
      });
    };

    const scegli = (zona: string) => {
      const dentroPercorso = Boolean(mappa.closest("#percorso"));
      document.dispatchEvent(
        new CustomEvent("tropini:zona", { detail: { zona, scorri: !dentroPercorso } }),
      );
    };

    scelte.forEach((elemento) => {
      elemento.addEventListener("click", () => {
        const zona = elemento.getAttribute("data-zona");
        if (zona) scegli(zona);
      });
      elemento.addEventListener("keydown", (evento) => {
        if (evento.key !== "Enter" && evento.key !== " ") return;
        evento.preventDefault();
        const zona = elemento.getAttribute("data-zona");
        if (zona) scegli(zona);
      });
    });

    document.addEventListener("tropini:zona", (evento) => {
      const zona = (evento as CustomEvent<{ zona?: string }>).detail?.zona;
      if (typeof zona === "string") segna(zona);
    });
  });
</script>
