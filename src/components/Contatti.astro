---
import MappaPiemonte from "./MappaPiemonte.astro";
---

<section class="contatti page-section" id="contatti">
  <div class="container">
    <div class="contatti__layout">
      <div class="contatti__copy">
        <span class="section-label">Contatti</span>
        <h2 class="section-title">La tua stufa ha bisogno di assistenza?</h2>
        <p class="section-subtitle">
          Chiamaci e descrivici il problema. Interveniamo su stufe a pellet e a legna
          in tutto il Piemonte.
        </p>

        <a href="tel:3342968625" class="contatti__phone">
          <span class="contatti__phone-label">Cellulare</span>
          <span class="contatti__phone-num">334 2968625</span>
        </a>

        <div class="contatti__details">
          <div>
            <span>Fisso</span>
            <a href="tel:0172382695">0172 382695</a>
          </div>
          <div>
            <span>Sede</span>
            <p>Via San Giorgio, 14<br />12030 Cavallermaggiore (CN)</p>
          </div>
          <div>
            <span>Orari</span>
            <p>
              Lun–Ven 8:00–18:00<br />
              Sab 8:00–12:00<br />
              <em>Reperibili anche nei festivi</em>
            </p>
          </div>
        </div>

        <a href="tel:3342968625" class="btn-primary contatti__cta">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
          </svg>
          Richiedi assistenza ora
        </a>
      </div>

      <div class="contatti__mappa">
        <MappaPiemonte />
      </div>
    </div>
  </div>
</section>

<style>
  .contatti__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .contatti__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .contatti__copy .section-subtitle {
    margin-top: 0.875rem;
    margin-bottom: 1.75rem;
  }

  .contatti__phone {
    display: block;
    margin-bottom: 1.75rem;
    transition: opacity 0.2s;
  }

  .contatti__phone:hover {
    opacity: 0.85;
  }

  .contatti__phone-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-400);
    margin-bottom: 0.25rem;
  }

  .contatti__phone-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-fire);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .contatti__details {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    margin-bottom: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .contatti__details span {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-400);
    margin-bottom: 0.3rem;
  }

  .contatti__details a,
  .contatti__details p {
    font-size: 0.975rem;
    color: var(--color-gray-700);
    line-height: 1.55;
  }

  .contatti__details a {
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .contatti__details em {
    font-style: normal;
    font-weight: 600;
    color: var(--color-fire);
  }

  .contatti__cta {
    width: 100%;
    max-width: 22rem;
  }

  .contatti__mappa {
    min-height: 28rem;
  }

  @media (max-width: 900px) {
    .contatti__layout {
      grid-template-columns: 1fr;
    }

    .contatti__mappa {
      min-height: 22rem;
    }
  }
</style>
