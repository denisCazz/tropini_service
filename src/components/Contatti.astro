---

<section class="contatti page-section" id="contatti">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Contatti</span>
      <h2 class="section-title">Dove siamo & Come contattarci</h2>
      <p class="section-subtitle">
        Siamo a Cavallermaggiore, a servizio di tutta la provincia di Cuneo.
      </p>
    </div>

    <div class="contatti__grid">
      <!-- Info Box -->
      <div class="contatti__info">
        <div class="contatti__info-card">
          <h3>Tropini Service</h3>
          <p class="contatti__ragione">di Tropini Gianfranco</p>

          <div class="contatti__item">
            <div class="contatti__item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <div class="contatti__item-label">Sede</div>
              <div class="contatti__item-value">Via San Giorgio, 14<br />12030 Cavallermaggiore (CN)</div>
            </div>
          </div>

          <div class="contatti__item">
            <div class="contatti__item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
              </svg>
            </div>
            <div>
              <div class="contatti__item-label">Cellulare (preferito)</div>
              <a href="tel:3342968625" class="contatti__item-value contatti__tel">334 2968625</a>
            </div>
          </div>

          <div class="contatti__item">
            <div class="contatti__item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
              </svg>
            </div>
            <div>
              <div class="contatti__item-label">Telefono fisso</div>
              <a href="tel:0172382695" class="contatti__item-value contatti__tel">0172 382695</a>
            </div>
          </div>

          <div class="contatti__item">
            <div class="contatti__item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <div class="contatti__item-label">Orari</div>
              <div class="contatti__item-value">
                Lun–Ven: 8:00–18:00<br />
                Sab: 8:00–12:00<br />
                <span class="contatti__festivi">⚡ Reperibili anche nei festivi</span>
              </div>
            </div>
          </div>

          <div class="contatti__item">
            <div class="contatti__item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <div>
              <div class="contatti__item-label">P. IVA</div>
              <div class="contatti__item-value">03474870049</div>
            </div>
          </div>

          <a href="tel:3342968625" class="btn-primary contatti__cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
            </svg>
            Chiamaci Ora
          </a>
        </div>
      </div>

      <!-- Map -->
      <div class="contatti__mappa">
        <div class="contatti__mappa-inner">
          <iframe
            src="https://www.openstreetmap.org/export/embed.html?bbox=7.648%2C44.698%2C7.680%2C44.718&layer=mapnik&marker=44.708%2C7.664"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            title="Mappa Tropini Service - Via San Giorgio 14, Cavallermaggiore CN"
          ></iframe>
        </div>
        <a
          href="https://www.openstreetmap.org/?mlat=44.708&mlon=7.664#map=15/44.708/7.664"
          target="_blank"
          rel="noopener noreferrer"
          class="contatti__mappa-link"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Apri in OpenStreetMap →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contatti__grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .contatti__info-card {
    background: var(--color-gray-50);
    border-radius: var(--radius);
    padding: 1.75rem;
    border: 1px solid var(--color-gray-200);
  }

  .contatti__info-card h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-gray-900);
    margin-bottom: 0.125rem;
  }

  .contatti__ragione {
    font-size: 0.875rem;
    color: var(--color-gray-400);
    margin-bottom: 1.75rem;
  }

  .contatti__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 0;
    border-top: 1px solid var(--color-gray-100);
  }

  .contatti__item-icon {
    width: 2.5rem;
    height: 2.5rem;
    background: rgba(220, 38, 38, 0.08);
    color: var(--color-fire);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contatti__item-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray-400);
    margin-bottom: 0.25rem;
  }

  .contatti__item-value {
    font-size: 0.9rem;
    color: var(--color-gray-700);
    line-height: 1.5;
  }

  .contatti__tel {
    color: var(--color-fire) !important;
    font-weight: 700;
    font-size: 1.05rem !important;
    transition: color 0.2s;
  }

  .contatti__tel:hover {
    color: var(--color-fire-dark) !important;
  }

  .contatti__festivi {
    display: inline-block;
    margin-top: 0.25rem;
    color: var(--color-orange);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .contatti__cta {
    width: 100%;
    justify-content: center;
    margin-top: 1.75rem;
  }

  .contatti__mappa {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contatti__mappa-inner {
    width: 100%;
    height: 400px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-gray-200);
  }

  .contatti__mappa-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.85rem;
    color: var(--color-blue);
    font-weight: 500;
    transition: color 0.2s;
  }

  .contatti__mappa-link:hover {
    color: var(--color-blue-dark);
  }

  @media (max-width: 960px) {
    .contatti__grid {
      grid-template-columns: 1fr;
    }

    .contatti__mappa-inner {
      height: 320px;
    }
  }
</style>
