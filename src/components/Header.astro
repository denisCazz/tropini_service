---
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <img src="/Logo_Tropini_Service.png" alt="Tropini Service" width="220" height="72" />
    </a>

    <nav class="site-header__nav" aria-label="Menu principale">
      <a href="/#servizi">Servizi</a>
      <a href="/#chi-siamo">Chi Siamo</a>
      <a href="/#recensioni">Recensioni</a>
      <a href="/#contatti">Contatti</a>
    </nav>

    <a href="tel:3342968625" class="btn-primary site-header__cta">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
      </svg>
      Chiama per supporto
    </a>

    <button
      type="button"
      class="site-header__toggle"
      aria-label="Apri menu"
      aria-expanded="false"
      aria-controls="site-header-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="site-header__drawer" id="site-header-menu" hidden>
    <nav aria-label="Menu mobile">
      <a href="/#servizi">Servizi</a>
      <a href="/#chi-siamo">Chi Siamo</a>
      <a href="/#recensioni">Recensioni</a>
      <a href="/#contatti">Contatti</a>
      <button type="button" class="theme-toggle site-header__drawer-theme" aria-label="Attiva tema scuro">
        <span>Tema</span>
        <span class="site-header__drawer-theme-value">
          <svg class="theme-toggle__sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="theme-toggle__moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span class="theme-toggle__label">Chiaro</span>
        </span>
      </button>
      <a href="tel:3342968625" class="btn-primary">Chiama ora</a>
    </nav>
  </div>
  <button class="site-header__backdrop" type="button" aria-label="Chiudi menu" hidden></button>
</header>

<script>
  const header = document.querySelector(".site-header");
  const toggle = header?.querySelector(".site-header__toggle");
  const themeToggles = document.querySelectorAll(".theme-toggle");
  const drawer = document.getElementById("site-header-menu");
  const backdrop = header?.querySelector(".site-header__backdrop");

  const updateThemeControl = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    themeToggles.forEach((control) => {
      control.setAttribute("aria-label", dark ? "Attiva tema chiaro" : "Attiva tema scuro");
      const label = control.querySelector(".theme-toggle__label");
      if (label) label.textContent = dark ? "Scuro" : "Chiaro";
    });
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      "content",
      dark ? "#0b1220" : "#ffffff",
    );
  };

  updateThemeControl();
  themeToggles.forEach((themeToggle) => {
    themeToggle.addEventListener("click", () => {
      const dark = document.documentElement.dataset.theme !== "dark";
      document.documentElement.dataset.theme = dark ? "dark" : "light";
      localStorage.setItem("theme", dark ? "dark" : "light");
      updateThemeControl();
    });
  });

  if (toggle && drawer) {
    const closeMenu = () => {
      drawer.setAttribute("hidden", "");
      backdrop?.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Apri menu");
      toggle.classList.remove("site-header__toggle--open");
      document.body.classList.remove("menu-open");
    };

    toggle.addEventListener("click", () => {
      const open = drawer.hasAttribute("hidden");
      drawer.toggleAttribute("hidden", !open);
      backdrop?.toggleAttribute("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Chiudi menu" : "Apri menu");
      toggle.classList.toggle("site-header__toggle--open", open);
      document.body.classList.toggle("menu-open", open);
    });

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    backdrop?.addEventListener("click", closeMenu);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !drawer.hasAttribute("hidden")) closeMenu();
    });

    window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    isolation: isolate;
    background: var(--color-header);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 3px rgb(15 23 42 / 0.06);
  }

  .site-header__inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .site-header__logo img {
    height: 56px;
    width: auto;
    display: block;
  }

  :global([data-theme="dark"]) .site-header__logo {
    display: inline-flex;
    padding: 0.2rem 0.35rem;
    background: #ffffff;
    border-radius: 0.45rem;
  }

  @media (max-width: 900px) {
    .site-header__logo img {
      height: 48px;
    }
  }

  .site-header__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .site-header__nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .site-header__nav a:hover {
    color: var(--color-blue);
  }

  .site-header__cta {
    font-size: 0.8125rem !important;
    padding: 0.5rem 1rem !important;
    white-space: nowrap;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    border: none;
    background: var(--color-control);
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .site-header__toggle--open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header__toggle--open span:nth-child(2) {
    opacity: 0;
  }

  .site-header__toggle--open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .site-header__drawer {
    position: fixed;
    z-index: 3;
    top: var(--header-h);
    right: 0;
    left: 0;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-elevated);
    padding: 0.5rem 0 1rem;
  }

  .site-header__drawer[hidden] {
    display: none;
  }

  .site-header__backdrop {
    position: fixed;
    z-index: 2;
    inset: var(--header-h) 0 0;
    width: 100%;
    height: calc(100dvh - var(--header-h));
    padding: 0;
    background: rgb(11 18 32 / 0.34);
    border: 0;
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    cursor: default;
  }

  .site-header__backdrop[hidden] {
    display: none;
  }

  .site-header__drawer nav {
    display: flex;
    flex-direction: column;
    padding: 0 var(--container-px);
  }

  .site-header__drawer a {
    padding: 0.875rem 0;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__drawer a.btn-primary {
    margin-top: 0.75rem;
    justify-content: center;
    border-bottom: none;
    color: var(--color-white);
  }

  .site-header__drawer-theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.875rem 0;
    color: var(--color-text);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .site-header__drawer-theme-value {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .theme-toggle__moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__sun {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__moon {
    display: block;
  }

  @media (max-width: 900px) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
    }

    .site-header__nav,
    .site-header__cta {
      display: none;
    }

    .site-header__toggle {
      display: flex;
      grid-column: 3;
      justify-self: end;
    }
  }
</style>
