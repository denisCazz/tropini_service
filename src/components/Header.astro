---
interface Props {
  variant?: "default" | "dark";
}

const { variant = "default" } = Astro.props;
---

<header class:list={["site-header", variant === "dark" && "site-header--dark"]}>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <img src="/Logo_Tropini_Service.png" alt="Tropini Service" width="220" height="72" />
    </a>

    <nav class="site-header__nav" aria-label="Menu principale">
      <a href="/#servizi">Servizi</a>
      <a href="/#chi-siamo">Chi Siamo</a>
      <a href="/#recensioni">Recensioni</a>
      <a href="/#contatti">Contatti</a>
    </nav>

    <a href="tel:3342968625" class="btn-primary site-header__cta">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
      </svg>
      334 2968625
    </a>

    <button
      type="button"
      class="site-header__toggle"
      aria-label="Apri menu"
      aria-expanded="false"
      aria-controls="site-header-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="site-header__drawer" id="site-header-menu" hidden>
    <nav aria-label="Menu mobile">
      <a href="/#servizi">Servizi</a>
      <a href="/#chi-siamo">Chi Siamo</a>
      <a href="/#recensioni">Recensioni</a>
      <a href="/#contatti">Contatti</a>
      <a href="tel:3342968625" class="btn-primary">Chiama ora</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  const toggle = header?.querySelector(".site-header__toggle");
  const drawer = document.getElementById("site-header-menu");

  if (toggle && drawer) {
    toggle.addEventListener("click", () => {
      const open = drawer.hidden;
      drawer.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.classList.toggle("site-header__toggle--open", open);
      document.body.classList.toggle("menu-open", open);
    });

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        drawer.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        toggle.classList.remove("site-header__toggle--open");
        document.body.classList.remove("menu-open");
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-gray-200);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
  }

  .site-header--dark {
    background: var(--color-gray-900);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .site-header--dark .site-header__nav a {
    color: rgba(255, 255, 255, 0.75);
  }

  .site-header--dark .site-header__nav a:hover {
    color: var(--color-white);
  }

  .site-header--dark .site-header__toggle {
    background: rgba(255, 255, 255, 0.1);
  }

  .site-header--dark .site-header__toggle span {
    background: var(--color-white);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .site-header__logo img {
    height: 68px;
    width: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .site-header__logo img {
      height: 56px;
    }
  }

  .site-header__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .site-header__nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gray-700);
    transition: color 0.2s;
  }

  .site-header__nav a:hover {
    color: var(--color-fire);
  }

  .site-header__cta {
    font-size: 0.8125rem !important;
    padding: 0.5rem 1rem !important;
    white-space: nowrap;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    border: none;
    background: var(--color-gray-100);
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-gray-800);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .site-header__toggle--open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header__toggle--open span:nth-child(2) {
    opacity: 0;
  }

  .site-header__toggle--open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .site-header__drawer {
    border-top: 1px solid var(--color-gray-100);
    background: var(--color-white);
    padding: 0.5rem 0 1rem;
  }

  .site-header__drawer[hidden] {
    display: none;
  }

  .site-header__drawer nav {
    display: flex;
    flex-direction: column;
    padding: 0 var(--container-px);
  }

  .site-header__drawer a {
    padding: 0.875rem 0;
    font-weight: 500;
    color: var(--color-gray-700);
    border-bottom: 1px solid var(--color-gray-100);
  }

  .site-header__drawer a.btn-primary {
    margin-top: 0.75rem;
    justify-content: center;
    border-bottom: none;
    color: var(--color-white);
  }

  @media (max-width: 900px) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
    }

    .site-header__nav,
    .site-header__cta {
      display: none;
    }

    .site-header__toggle {
      display: flex;
      grid-column: 3;
      justify-self: end;
    }
  }
</style>
