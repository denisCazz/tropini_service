---
const servizi = [
  {
    num: "01",
    titolo: "Stufe a pellet",
    descrizione:
      "Diagnosi, riparazione e manutenzione per far tornare la stufa a funzionare in modo sicuro ed efficiente.",
    points: ["Diagnosi guasti", "Manutenzione", "Riparazione componenti"],
    prefill: { stufa: "pellet" },
  },
  {
    num: "02",
    titolo: "Assistenza multibrand",
    descrizione:
      "Extraflame, Eva Calor e decine di altre marche: intervento esperto anche sui guasti più ostici.",
    points: ["Extraflame", "Eva Calor", "Decine di marchi"],
    prefill: {},
  },
  {
    num: "03",
    titolo: "Pulizia stufe",
    descrizione:
      "Pulizia accurata dei componenti interni per mantenere la stufa efficiente, sicura e pronta all’uso.",
    points: ["Braciere", "Camera di combustione", "Controllo residui"],
    prefill: { problema: "manutenzione" },
  },
  {
    num: "04",
    titolo: "Manutenzione",
    descrizione:
      "Controlli periodici e interventi preventivi per ridurre i guasti e prolungare la vita della stufa.",
    points: ["Verifica componenti", "Controllo funzionale", "Prevenzione guasti"],
    prefill: { problema: "manutenzione" },
  },
  {
    num: "05",
    titolo: "Installazioni",
    descrizione:
      "Installazione e configurazione di stufe a pellet, con verifica del corretto funzionamento.",
    points: ["Posizionamento", "Configurazione", "Collaudo"],
    prefill: { problema: "installazione" },
  },
  {
    num: "06",
    titolo: "Schede elettroniche",
    descrizione:
      "Programmazione, diagnosi e riparazione delle schede elettroniche che gestiscono il funzionamento della stufa.",
    points: ["Programmazione", "Diagnosi elettronica", "Riparazione"],
    prefill: { problema: "errore" },
  },
  {
    num: "07",
    titolo: "Reperimento materiali",
    descrizione:
      "Ricerca di ricambi, componenti e materiali anche per modelli datati o difficili da trovare.",
    points: ["Ricambi", "Componenti rari", "Materiali compatibili"],
    prefill: { problema: "ricambio" },
  },
];
---

<section class="servizi page-section page-section--alt" id="servizi">
  <div class="container">
    <div class="servizi__top">
      <div class="section-header">
        <span class="section-label">Cosa facciamo</span>
        <h2 class="section-title">Assistenza completa per la tua stufa</h2>
        <p class="section-subtitle">
          Dalla diagnosi alla riparazione: interveniamo su stufe a pellet
          di tutte le principali marche.
        </p>
      </div>
      <a href="tel:3342968625" class="btn-primary servizi__top-cta">
        Richiedi assistenza
      </a>
    </div>

    <div class="servizi__list">
      {servizi.map((s) => (
        <article class="servizi__item">
          <span class="servizi__num" aria-hidden="true">{s.num}</span>
          <div class="servizi__body">
            <h3 class="servizi__titolo">{s.titolo}</h3>
            <p class="servizi__desc">{s.descrizione}</p>
            <ul class="servizi__points">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
            <button type="button" class="servizi__apri" data-prefill={JSON.stringify(s.prefill)}>
              Descrivi il problema
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .servizi__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .servizi__top .section-header {
    margin-bottom: 0;
  }

  .servizi__top-cta {
    flex-shrink: 0;
  }

  .servizi__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .servizi__item {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    min-height: 100%;
    padding: 1.5rem;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    transition: border-color 0.2s ease;
  }

  .servizi__item:hover {
    border-color: var(--color-text-strong);
  }

  .servizi__num {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-bg);
    background: var(--color-text-strong);
    border-radius: 0;
    line-height: 1;
  }

  .servizi__body {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .servizi__titolo {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-strong);
    margin-bottom: 0.65rem;
  }

  .servizi__desc {
    font-size: 0.975rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 1.15rem;
  }

  .servizi__points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .servizi__points li {
    position: relative;
    padding-left: 1.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .servizi__apri {
    align-self: flex-start;
    margin-top: 1rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-fire);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .servizi__apri:hover {
    color: var(--color-fire-dark);
  }

  .servizi__points li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: -0.05em;
    color: var(--color-orange);
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .servizi__top {
      flex-direction: column;
      align-items: flex-start;
    }

    .servizi__top-cta {
      width: 100%;
    }

    .servizi__list {
      grid-template-columns: 1fr;
    }

    .servizi__item {
      padding: 1.35rem;
    }
  }
</style>

<script>
  document.querySelectorAll(".servizi__apri").forEach((pulsante) => {
    pulsante.addEventListener("click", () => {
      const grezzo = pulsante.getAttribute("data-prefill") || "{}";
      const dettaglio = JSON.parse(grezzo) as { stufa?: string; problema?: string };
      document.dispatchEvent(new CustomEvent("tropini:percorso", { detail: dettaglio }));
    });
  });
</script>
