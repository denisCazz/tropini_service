---
const servizi = [
  {
    num: "01",
    titolo: "Stufe a pellet",
    descrizione:
      "Diagnosi, riparazione e manutenzione per far tornare la stufa a funzionare in modo sicuro ed efficiente.",
    points: ["Diagnosi guasti", "Manutenzione", "Riparazione componenti"],
  },
  {
    num: "02",
    titolo: "Stufe a legna",
    descrizione:
      "Controllo e riparazione della stufa a legna per un calore affidabile e prestazioni ottimali.",
    points: ["Controllo funzionale", "Manutenzione", "Verifica sicurezza"],
  },
  {
    num: "03",
    titolo: "Assistenza multibrand",
    descrizione:
      "Extraflame, Eva Calor e decine di altre marche: intervento esperto anche sui guasti più ostici.",
    points: ["Extraflame", "Eva Calor", "Decine di marchi"],
  },
];
---

<section class="servizi page-section page-section--alt" id="servizi">
  <div class="container">
    <div class="servizi__top">
      <div class="section-header">
        <span class="section-label">Servizi</span>
        <h2 class="section-title">Tutto ciò che serve alla tua stufa</h2>
        <p class="section-subtitle">
          Specializzati in stufe a pellet e a legna. Oltre 4.000 clienti in tutto il Piemonte.
        </p>
      </div>
      <a href="tel:3342968625" class="btn-primary servizi__top-cta">
        Richiedi assistenza
      </a>
    </div>

    <div class="servizi__list">
      {servizi.map((s) => (
        <article class="servizi__item">
          <span class="servizi__num" aria-hidden="true">{s.num}</span>
          <div class="servizi__body">
            <h3 class="servizi__titolo">{s.titolo}</h3>
            <p class="servizi__desc">{s.descrizione}</p>
            <ul class="servizi__points">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .servizi__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .servizi__top .section-header {
    margin-bottom: 0;
  }

  .servizi__top-cta {
    flex-shrink: 0;
  }

  .servizi__list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-gray-200);
  }

  .servizi__item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.25rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .servizi__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-fire);
    line-height: 1.2;
    padding-top: 0.15rem;
  }

  .servizi__titolo {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: 0.5rem;
  }

  .servizi__desc {
    font-size: 1rem;
    color: var(--color-gray-600);
    line-height: 1.65;
    max-width: 38rem;
    margin-bottom: 0.875rem;
  }

  .servizi__points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .servizi__points li {
    position: relative;
    padding-left: 0.9rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-700);
  }

  .servizi__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-fire);
  }

  @media (max-width: 720px) {
    .servizi__top {
      flex-direction: column;
      align-items: flex-start;
    }

    .servizi__top-cta {
      width: 100%;
    }

    .servizi__item {
      grid-template-columns: 3rem 1fr;
      gap: 0.75rem;
      padding: 1.35rem 0;
    }
  }
</style>
