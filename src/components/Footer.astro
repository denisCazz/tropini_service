---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <img src="/Logo_Tropini_Service.png" alt="Tropini Service" class="footer__logo" />
      <p>Assistenza caldaie, stufe a pellet<br />e impianti idraulici — Cuneo e provincia.</p>
      <div class="footer__badges">
        <span class="footer__badge">CAT Qlima</span>
        <span class="footer__badge">CAT Clam</span>
        <span class="footer__badge">P.IVA 03474870049</span>
      </div>
    </div>

    <div class="footer__nav">
      <h4>Navigazione</h4>
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#servizi">Servizi</a></li>
        <li><a href="#chi-siamo">Chi Siamo</a></li>
        <li><a href="#recensioni">Recensioni</a></li>
        <li><a href="#contatti">Contatti</a></li>
      </ul>
    </div>

    <div class="footer__servizi">
      <h4>Servizi</h4>
      <ul>
        <li>Assistenza Caldaie</li>
        <li>Stufe a Pellet (CAT)</li>
        <li>Riparazione Schede Elettroniche</li>
        <li>Climatizzazione</li>
        <li>Impianti Idraulici</li>
      </ul>
    </div>

    <div class="footer__contatti">
      <h4>Contatti Rapidi</h4>
      <a href="tel:3342968625" class="footer__tel">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
        </svg>
        334 2968625
      </a>
      <a href="tel:0172382695" class="footer__tel footer__tel--secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
        </svg>
        0172 382695
      </a>
      <p class="footer__address">
        Via San Giorgio, 14<br />
        12030 Cavallermaggiore (CN)
      </p>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {new Date().getFullYear()} Tropini Service di Tropini Gianfranco — P.IVA 03474870049. Tutti i diritti riservati.</p>
      <p>Sito realizzato con ❤️ a Cavallermaggiore</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-gray-900);
    color: rgba(255, 255, 255, 0.75);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
    align-items: start;
  }

  .footer__logo {
    display: block;
    height: 42px;
    width: auto;
    margin-bottom: 0.875rem;
  }

  .footer__brand p {
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .footer__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer__badge {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
  }

  .footer__nav h4,
  .footer__servizi h4,
  .footer__contatti h4 {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: 1.25rem;
  }

  .footer__nav ul,
  .footer__servizi ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer__nav li a {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .footer__nav li a:hover {
    color: var(--color-white);
  }

  .footer__servizi li {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer__contatti {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer__tel {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #fb923c;
    font-size: 1.1rem;
    font-weight: 700;
    transition: color 0.2s;
  }

  .footer__tel:hover {
    color: #fbbf24;
  }

  .footer__tel--secondary {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .footer__tel--secondary:hover {
    color: var(--color-white);
  }

  .footer__address {
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.25rem;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.25rem 0;
  }

  .footer__bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer__bottom p {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }

    .footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
