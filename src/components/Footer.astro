---
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <img src="/Logo_Tropini_Service.png" alt="Tropini Service" class="footer__logo" />
      <p>
        Assistenza specializzata per stufe a pellet e a legna in tutto il Piemonte.
      </p>
    </div>

    <div class="footer__cols">
      <div>
        <h4>Navigazione</h4>
        <ul>
          <li><a href="#home">Home</a></li>
          <li><a href="#servizi">Servizi</a></li>
          <li><a href="#chi-siamo">Chi Siamo</a></li>
          <li><a href="#recensioni">Recensioni</a></li>
          <li><a href="#contatti">Contatti</a></li>
        </ul>
      </div>

      <div>
        <h4>Servizi</h4>
        <ul>
          <li>Stufe a pellet</li>
          <li>Stufe a legna</li>
          <li>Manutenzione</li>
          <li>Riparazione schede</li>
        </ul>
      </div>

      <div>
        <h4>Contatti</h4>
        <a href="tel:3342968625" class="footer__tel">334 2968625</a>
        <a href="tel:0172382695" class="footer__tel footer__tel--sec">0172 382695</a>
        <p class="footer__address">
          Via San Giorgio, 14<br />
          12030 Cavallermaggiore (CN)
        </p>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>
        © {new Date().getFullYear()} Tropini Service di Tropini Gianfranco — P.IVA 03474870049
      </p>
      <p class="footer__credit">
        Sito sviluppato da{" "}
        <a href="https://bitora.it" target="_blank" rel="noopener noreferrer">bitora.it</a>
      </p>
      <button type="button" class="theme-toggle footer__theme-toggle" aria-label="Attiva tema scuro">
        <svg class="theme-toggle__sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-toggle__moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        Tema <span class="theme-toggle__label">Chiaro</span>
      </button>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0b1b36;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    gap: 3rem;
    padding-top: 3.5rem;
    padding-bottom: 3rem;
  }

  .footer__logo {
    height: 48px;
    width: auto;
    margin-bottom: 1rem;
    padding: 0.3rem 0.45rem;
    background: #ffffff;
    border-radius: 0.45rem;
  }

  .footer__brand p {
    font-size: 0.925rem;
    line-height: 1.6;
    max-width: 18rem;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer__cols h4 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .footer__cols ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer__cols li,
  .footer__cols a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .footer__cols a:hover {
    color: var(--color-white);
  }

  .footer__tel {
    display: block;
    color: #fdba74 !important;
    font-size: 1.15rem !important;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .footer__tel--sec {
    color: rgba(255, 255, 255, 0.65) !important;
    font-size: 0.9rem !important;
    font-weight: 500 !important;
    margin-bottom: 0.85rem;
  }

  .footer__address {
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.15rem 0;
  }

  .footer__bottom-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer__bottom p {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer__credit a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .footer__credit a:hover {
    color: var(--color-white);
  }

  .footer__theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    color: rgba(255, 255, 255, 0.6);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: color 0.2s;
  }

  .footer__theme-toggle:hover {
    color: var(--color-white);
  }

  .theme-toggle__moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__sun {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__moon {
    display: block;
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer__cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
