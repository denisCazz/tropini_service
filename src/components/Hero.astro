---
---

<section class="hero" id="home" aria-label="Introduzione">
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__container">
    <div class="hero__content">
      <p class="hero__badge">
        <span aria-hidden="true">✓</span> Centro Assistenza Autorizzato Qlima & Clam
      </p>
      <h1 class="hero__title">
        Assistenza Caldaie,<br />
        <span class="hero__title-highlight">Stufe a Pellet</span><br />
        & Biomasse
      </h1>
      <p class="hero__subtitle">
        Interventi rapidi a <strong>Cavallermaggiore, Cuneo e provincia</strong>.
        Riparazione schede elettroniche, manutenzione caldaie e biomasse — anche nei weekend e festivi.
      </p>
      <div class="hero__actions">
        <a href="tel:3342968625" class="btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
          </svg>
          Chiamaci — 334 2968625
        </a>
        <a href="#servizi" class="btn-secondary">Scopri i servizi</a>
      </div>
      <ul class="hero__features">
        <li><span aria-hidden="true">⚡</span> Intervento rapido</li>
        <li><span aria-hidden="true">🏅</span> CAT autorizzato</li>
        <li><span aria-hidden="true">📅</span> Disponibile nei festivi</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: url("/hero.png") center / cover no-repeat;
    color: var(--color-white);
    padding: clamp(3rem, 8vh, 5rem) 0 clamp(3.5rem, 9vh, 5.5rem);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.75) 0%,
      rgba(30, 27, 75, 0.65) 40%,
      rgba(124, 45, 18, 0.75) 100%
    );
    pointer-events: none;
  }

  .hero__container {
    position: relative;
    z-index: 1;
  }

  .hero__content {
    max-width: 38rem;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #fde68a;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .hero__title-highlight {
    background: linear-gradient(90deg, #fb923c, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 2rem;
  }

  .hero__subtitle strong {
    color: var(--color-white);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .hero__features {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero__features li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .hero__actions {
      flex-direction: column;
    }

    .hero__actions .btn-primary,
    .hero__actions .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
