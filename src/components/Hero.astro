---
---

<section class="hero" id="home" aria-label="Introduzione">
  <div class="hero__media" aria-hidden="true">
    <img
      class="hero__poster"
      src="/hero.png"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <video
      class="hero__video"
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/hero.png"
    >
      <source data-src="/videos/hero-4k.mp4" data-min="1400" type="video/mp4" />
      <source data-src="/videos/hero-1080.mp4" data-min="768" type="video/mp4" />
      <source data-src="/videos/hero-720.mp4" data-min="0" type="video/mp4" />
    </video>
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__container">
    <div class="hero__content">
      <p class="hero__eyebrow">Oltre 4.000 clienti · Tutto il Piemonte</p>

      <h1 class="hero__title">
        Assistenza<br />
        <span class="hero__title-accent">stufe a pellet</span><br />
        e a legna
      </h1>

      <p class="hero__subtitle">
        Extraflame, Eva Calor e decine di altre marche.
        Interventi rapidi, anche nei weekend e nei festivi.
      </p>

      <div class="hero__actions">
        <a href="tel:3342968625" class="btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.16z"/>
          </svg>
          Chiama ora — 334 2968625
        </a>
        <a href="#contatti" class="btn-secondary">Richiedi intervento</a>
      </div>

      <p class="hero__proof">
        Specialisti multibrand · Diagnosi e riparazione · Disponibili nei festivi
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(88vh, 44rem);
    display: flex;
    align-items: center;
    color: var(--color-white);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__video {
    opacity: 0;
    transition: opacity 1.1s ease;
    transform: scale(1.04);
    transform-origin: center;
  }

  .hero__video.is-ready {
    opacity: 1;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        rgba(17, 24, 39, 0.92) 0%,
        rgba(17, 24, 39, 0.78) 42%,
        rgba(124, 45, 18, 0.45) 72%,
        rgba(124, 45, 18, 0.28) 100%
      );
  }

  .hero__container {
    width: 100%;
    padding-block: clamp(3.5rem, 10vh, 6.5rem);
  }

  .hero__content {
    max-width: 36rem;
    animation: hero-rise 0.7s ease-out both;
  }

  .hero__eyebrow {
    margin-bottom: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fcd34d;
  }

  .hero__title {
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 6vw, 3.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero__title-accent {
    background: linear-gradient(90deg, #fb923c, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    max-width: 30rem;
    margin-bottom: 2rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }

  .hero__proof {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      align-items: flex-end;
    }

    .hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(17, 24, 39, 0.55) 0%,
          rgba(17, 24, 39, 0.82) 45%,
          rgba(17, 24, 39, 0.94) 100%
        );
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__actions .btn-primary,
    .hero__actions .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content {
      animation: none;
    }

    .hero__video {
      display: none;
    }
  }
</style>

<script>
  const video = document.getElementById("hero-video");
  if (video instanceof HTMLVideoElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      video.remove();
    } else {
      const sources = [...video.querySelectorAll("source")];
      const width = window.innerWidth;
      const connection = "connection" in navigator ? navigator.connection : null;
      const saveData = Boolean(connection && "saveData" in connection && connection.saveData);
      const pick =
        sources.find((s) => {
          const min = Number(s.getAttribute("data-min") || 0);
          if (saveData && min >= 1400) return false;
          return width >= min;
        }) || sources[sources.length - 1];

      const src = pick?.getAttribute("data-src");
      if (src) video.src = src;

      const markReady = () => video.classList.add("is-ready");
      if (video.readyState >= 2) markReady();
      video.addEventListener("loadeddata", markReady);
      video.play().catch(() => {});
    }
  }
</script>
