---
export interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description = "Tropini Service: assistenza specializzata per stufe a pellet in tutto il Piemonte. Oltre 4.000 clienti, Extraflame, Eva Calor e decine di altre marche.",
  robots,
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.theme = "light";
      localStorage.removeItem("theme");
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    color-scheme: light;
    --color-fire-dark: #7c2d12;
    --color-fire: #9a3412;
    --color-fire-light: #c2410c;
    --color-orange: #9a3412;
    --color-orange-light: #c2410c;
    --color-amber: #c2410c;
    --color-blue: #141414;
    --color-blue-light: #141414;
    --color-blue-dark: #141414;
    --color-gray-50: #f4f5f6;
    --color-gray-100: #f4f5f6;
    --color-gray-200: #d9dde3;
    --color-gray-400: #2a2a2a;
    --color-gray-600: #222222;
    --color-gray-700: #1a1a1a;
    --color-gray-800: #141414;
    --color-gray-900: #141414;
    --color-white: #ffffff;
    --color-bg: #ffffff;
    --color-surface: #f4f5f6;
    --color-surface-elevated: #ffffff;
    --color-text: #111111;
    --color-text-strong: #000000;
    --color-text-muted: #222222;
    --color-border: #d9dde3;
    --color-header: rgba(255, 255, 255, 0.96);
    --color-control: #f4f5f6;
    --color-control-hover: #e8eaed;
    --color-on-dark: #ffffff;
    --color-on-dark-muted: rgba(255, 255, 255, 0.72);
    --font-family: "IBM Plex Sans", system-ui, sans-serif;
    --font-display: "IBM Plex Sans", system-ui, sans-serif;
    --radius: 0;
    --radius-lg: 0;
    --container-max: 1120px;
    --container-px: clamp(1.25rem, 4vw, 2rem);
    --header-h: 4.75rem;
    --section-y: clamp(4rem, 8vw, 6.5rem);
    --shadow: none;
    --shadow-lg: none;
    --shadow-xl: none;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --color-blue: #f2f2f2;
    --color-blue-light: #f2f2f2;
    --color-blue-dark: #f2f2f2;
    --color-gray-50: #141414;
    --color-gray-100: #1a1a1a;
    --color-gray-200: #2a2a2a;
    --color-gray-400: #a3a3a3;
    --color-gray-600: #c4c4c4;
    --color-gray-700: #e5e5e5;
    --color-gray-800: #f2f2f2;
    --color-gray-900: #ffffff;
    --color-bg: #0e0e0e;
    --color-surface: #141414;
    --color-surface-elevated: #1a1a1a;
    --color-text: #f2f2f2;
    --color-text-strong: #ffffff;
    --color-text-muted: #d6d6d6;
    --color-border: #2a2a2a;
    --color-header: rgba(14, 14, 14, 0.96);
    --color-control: #1a1a1a;
    --color-control-hover: #242424;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--header-h) + 1rem);
    background: var(--color-bg);
  }

  body {
    font-family: var(--font-family);
    color: var(--color-text);
    background: #ffffff;
    font-size: 1.125rem;
    line-height: 1.65;
    overflow-x: hidden;
  }

  body.menu-open {
    overflow: hidden;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    text-decoration: none;
  }

  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  .page-section {
    padding-block: var(--section-y);
  }

  .page-section--alt {
    background: var(--color-surface);
  }

  .section-header {
    max-width: 40rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-header--center {
    text-align: center;
    margin-inline: auto;
  }

  .section-header .section-subtitle {
    margin-top: 0.875rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 600;
    color: var(--color-text-strong);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 36rem;
  }

  .section-header--center .section-subtitle {
    margin-inline: auto;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #9a3412;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.975rem;
    padding: 0.9rem 1.6rem;
    border-radius: 0;
    box-shadow: none;
    transition: background 0.2s;
    border: 1px solid #9a3412;
    cursor: pointer;
  }

  .btn-primary:hover {
    background: #7c2d12;
    border-color: #7c2d12;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--color-white);
    font-weight: 600;
    font-size: 0.975rem;
    padding: 0.9rem 1.6rem;
    border-radius: 0;
    border: 1px solid rgba(255, 255, 255, 0.55);
    transition: background 0.2s, border-color 0.2s;
    cursor: pointer;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--color-white);
  }

  .btn-secondary--dark {
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn-secondary--dark:hover {
    background: var(--color-surface);
    border-color: var(--color-text-muted);
  }

</style>
